{
  "ConnectionStrings": {
    "HexaConnection": "${CARPLATES_DB_CONNECTION}"
  },
  "JWT": {
    "Key": "${CARPLATES_JWT_KEY}",
    "Issuer": "${CARPLATES_JWT_ISSUER}",
    "Audience": "${CARPLATES_JWT_AUDIENCE}"
  },
  "LegacyDes": {
    "Key": "${CARPLATES_LEGACY_DES_KEY}",
    "Iv": "${CARPLATES_LEGACY_DES_IV}"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": "http://localhost:4200"
  }
}

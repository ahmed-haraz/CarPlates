<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CarPlates.Mobile.ViewModels"
             xmlns:loc="clr-namespace:CarPlates.Mobile.Localization"
             x:Class="CarPlates.Mobile.Views.Settings.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
            <!-- Appearance Section -->
            <Label Text="{loc:Translate Key=Appearance}" Style="{StaticResource Title}"/>
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{loc:Translate Key=DarkMode}" Style="{StaticResource Body}" VerticalOptions="Center"/>
                        <Switch Grid.Column="1" IsToggled="{Binding IsDarkMode}"/>
                    </Grid>
                    <BoxView HeightRequest="1" Color="{DynamicResource Border}" Margin="0,4"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{loc:Translate Key=Language}" Style="{StaticResource Body}" VerticalOptions="Center"/>
                        <Picker Grid.Column="1" 
                                ItemsSource="{Binding AvailableLanguages}"
                                SelectedItem="{Binding SelectedLanguage}"
                                WidthRequest="120"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Scanner Section -->
            <Label Text="{loc:Translate Key=Scanner}" Style="{StaticResource Title}" Margin="0,8,0,0"/>
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{loc:Translate Key=OcrConfidence}" Style="{StaticResource Body}" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="{Binding OcrConfidence, StringFormat='{0:P0}'}" Style="{StaticResource Caption}"/>
                    </Grid>
                    <Slider Minimum="0.5" Maximum="1.0" Value="{Binding OcrConfidence}" Margin="0,-8,0,0"/>
                    <BoxView HeightRequest="1" Color="{DynamicResource Border}" Margin="0,4"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{loc:Translate Key=AutoResumeScanning}" Style="{StaticResource Body}" VerticalOptions="Center"/>
                        <Switch Grid.Column="1" IsToggled="{Binding AutoResume}"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- API Section -->
            <Label Text="{loc:Translate Key=ApiConfiguration}" Style="{StaticResource Title}" Margin="0,8,0,0"/>
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{loc:Translate Key=ApiUrl}" Style="{StaticResource Body}" FontAttributes="Bold"/>
                    <Entry Text="{Binding ApiUrl}" Placeholder="https://api.example.com"
                           IsPassword="{Binding IsApiUrlLocked}"
                           IsReadOnly="{Binding IsApiUrlLocked}"/>

                    <!-- Unlock UI when API URL is locked -->
                    <VerticalStackLayout Spacing="8" IsVisible="{Binding IsApiUrlLocked}">
                        <Entry Placeholder="Enter settings password"
                               Text="{Binding ApiUrlPassword}"
                               IsPassword="True"/>
                        <Button Text="Unlock API URL"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding UnlockApiUrlCommand}"
                                HeightRequest="40"
                                FontSize="14"/>
                    </VerticalStackLayout>

                    <!-- Lock button when API URL is unlocked -->
                    <Button Text="Lock API URL"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding LockApiUrlCommand}"
                            HeightRequest="40"
                            FontSize="14"
                            IsVisible="{Binding IsApiUrlLocked, Converter={StaticResource InvertedBoolConverter}}"/>

                    <Button Text="{loc:Translate Key=TestConnectionButton}"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding TestConnectionCommand}"
                            HeightRequest="40"
                            FontSize="14"/>
                </VerticalStackLayout>
            </Border>

            <!-- Notifications Section -->
            <Label Text="{loc:Translate Key=Notifications}" Style="{StaticResource Title}" Margin="0,8,0,0"/>
            <Border Style="{StaticResource Card}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="{loc:Translate Key=EnableNotifications}" Style="{StaticResource Body}" VerticalOptions="Center"/>
                    <Switch Grid.Column="1" IsToggled="{Binding NotificationsEnabled}"/>
                </Grid>
            </Border>

            <!-- Payment Gateway Section -->
            <Label Text="Payment Gateway" Style="{StaticResource Title}" Margin="0,8,0,0"/>
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Enable Gateway" Style="{StaticResource Body}" VerticalOptions="Center"/>
                        <Switch Grid.Column="1" IsToggled="{Binding PaymentGatewayEnabled}"/>
                    </Grid>
                    <BoxView HeightRequest="1" Color="{DynamicResource Border}" Margin="0,4"/>
                    <Label Text="Gateway Name" Style="{StaticResource Body}" FontAttributes="Bold"/>
                    <Entry Placeholder="e.g. Stripe, PayPal, Mada" Text="{Binding PaymentGatewayName}"/>
                    <Label Text="Merchant ID" Style="{StaticResource Body}" FontAttributes="Bold"/>
                    <Entry Placeholder="Merchant ID" Text="{Binding PaymentMerchantId}"/>
                    <Label Text="API Key" Style="{StaticResource Body}" FontAttributes="Bold"/>
                    <Entry Placeholder="API Key" Text="{Binding PaymentApiKey}" IsPassword="True"/>
                    <Label Text="Endpoint URL" Style="{StaticResource Body}" FontAttributes="Bold"/>
                    <Entry Placeholder="https://api.gateway.com" Text="{Binding PaymentEndpointUrl}"/>
                    <Label Text="Additional Settings (JSON)" Style="{StaticResource Body}" FontAttributes="Bold"/>
                    <Editor Placeholder='{}{"key": "value"}' Text="{Binding PaymentAdditionalSettings}"
                            HeightRequest="60" FontSize="12"/>
                </VerticalStackLayout>
            </Border>

            <!-- Print Settings -->
            <Label Text="Print Settings" Style="{StaticResource Title}" Margin="0,8,0,0"/>
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Use saved print settings" Style="{StaticResource Body}" VerticalOptions="Center"/>
                        <Switch Grid.Column="1" IsToggled="{Binding UseSavedPrintSettings}"/>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{DynamicResource Border}" Margin="0,4"/>

                    <Label Text="Default Printer" Style="{StaticResource Body}" FontAttributes="Bold"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Picker Grid.Column="0"
                                ItemsSource="{Binding AvailablePrinters}"
                                SelectedItem="{Binding SelectedPrinter}"
                                IsVisible="{Binding HasPrinters}"/>
                        <Button Grid.Column="1" Text="Refresh"
                                Command="{Binding RefreshPrintersCommand}"
                                HeightRequest="40" FontSize="12"
                                Padding="12,0"/>
                    </Grid>
                    <Label Text="No Bluetooth printers found. Tap Refresh or use a network IP below."
                           IsVisible="{Binding HasPrinters, Converter={StaticResource InvertedBoolConverter}}"
                           Style="{StaticResource Caption}" FontSize="12"/>

                    <Label Text="Or enter network printer IP:Port" Style="{StaticResource Caption}"/>
                    <Entry Placeholder="192.168.1.100:9100" Text="{Binding PrinterIp}"
                           IsEnabled="{Binding IsIpEntryEnabled}"/>

                    <BoxView HeightRequest="1" Color="{DynamicResource Border}" Margin="0,4"/>

                    <Label Text="Print Format" Style="{StaticResource Body}" FontAttributes="Bold"/>
                    <Picker ItemsSource="{Binding PrintFormatOptions}"
                            SelectedIndex="{Binding SelectedPrintFormatIndex}"/>

                    <Label Text="Print Language" Style="{StaticResource Body}" FontAttributes="Bold"/>
                    <Picker ItemsSource="{Binding PrintLanguageOptions}"
                            SelectedIndex="{Binding SelectedPrintLanguageIndex}"/>
                </VerticalStackLayout>
            </Border>

            <!-- Data Management -->
            <Label Text="{loc:Translate Key=DataManagement}" Style="{StaticResource Title}" Margin="0,8,0,0"/>
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Button Text="{loc:Translate Key=ViewLogsButton}"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ViewLogsCommand}"
                            HeightRequest="44"/>
                </VerticalStackLayout>
            </Border>

            <!-- Save Button -->
            <Button Text="{loc:Translate Key=SaveSettingsButton}"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding SaveSettingsCommand}"
                    HeightRequest="56"
                    Margin="0,16,0,0"/>

            <!-- About & Logout -->
            <VerticalStackLayout Spacing="8" Margin="0,16,0,0">
                <Button Text="{loc:Translate Key=AboutButton}"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding NavigateToAboutCommand}"
                        HeightRequest="44"/>
                <Button Text="{loc:Translate Key=LogoutButton}"
                        BackgroundColor="{StaticResource Error}"
                        TextColor="White"
                        Command="{Binding LogoutCommand}"
                        HeightRequest="44"
                        CornerRadius="12"/>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

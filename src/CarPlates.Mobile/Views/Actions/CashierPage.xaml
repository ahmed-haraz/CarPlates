<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CarPlates.Mobile.ViewModels"
             xmlns:loc="clr-namespace:CarPlates.Mobile.Localization"
             xmlns:helpers="clr-namespace:CarPlates.Mobile.Helpers"
             x:Class="CarPlates.Mobile.Views.Actions.CashierPage"
             x:DataType="vm:CashierViewModel"
             Title="{Binding Title}"
             BackgroundColor="{DynamicResource Background}">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

        <!-- Search Bar + Toggle buttons -->
        <Grid Grid.Row="0"
              Padding="20,18,20,8"
              ColumnDefinitions="*,Auto,Auto">
            <SearchBar Grid.Column="0"
                       Placeholder="{loc:Translate Key=SearchByPlate}"
                       Text="{Binding SearchText}" />
            <Button Grid.Column="1"
                    Text="🔍"
                    Style="{StaticResource IconButton}"
                    Command="{Binding LoadBillsCommand}" />
            <Button Grid.Column="2"
                    Text="📅"
                    Style="{StaticResource IconButton}"
                    Command="{Binding ToggleDateFilterCommand}" />
        </Grid>

        <!-- Date Filter Panel (toggleable) -->
        <Grid Grid.Row="1"
              Padding="20,0,20,8"
              ColumnDefinitions="*,*,Auto"
              ColumnSpacing="8"
              IsVisible="{Binding IsDateFilterVisible}">
            <DatePicker Grid.Column="0"
                        Date="{Binding DateFrom}"
                        FontSize="13" />
            <DatePicker Grid.Column="1"
                        Date="{Binding DateTo}"
                        FontSize="13" />
            <HorizontalStackLayout Grid.Column="2" Spacing="4">
                <Button Text="✓" Style="{StaticResource IconButton}"
                        Command="{Binding ApplyDateFilterCommand}" />
                <Button Text="✗" Style="{StaticResource IconButton}"
                        Command="{Binding ClearDateFilterCommand}" />
            </HorizontalStackLayout>
        </Grid>

        <!-- Status filter indicators -->
        <HorizontalStackLayout Grid.Row="2" Padding="20,4" Spacing="8">
            <Border StrokeShape="RoundRectangle 12" Padding="8,4" BackgroundColor="{DynamicResource Surface}"
                    StrokeThickness="0" IsVisible="{Binding ShowAllBills}">
                <Label Text="All" FontSize="12" TextColor="{DynamicResource TextSecondary}" />
            </Border>
            <Border StrokeShape="RoundRectangle 12" Padding="8,4" BackgroundColor="{DynamicResource Surface}"
                    StrokeThickness="0" IsVisible="{Binding ShowPaidBills}">
                <Label Text="Paid" FontSize="12" TextColor="{DynamicResource Success}" />
            </Border>
            <Border StrokeShape="RoundRectangle 12" Padding="8,4" BackgroundColor="{DynamicResource Surface}"
                    StrokeThickness="0" IsVisible="{Binding ShowUnpaidBills}">
                <Label Text="Unpaid" FontSize="12" TextColor="{DynamicResource Warning}" />
            </Border>
        </HorizontalStackLayout>

        <!-- Bills List -->
        <CollectionView Grid.Row="4"
                        ItemsSource="{Binding Bills}"
                        Margin="16,8"
                        EmptyView="{loc:Translate Key=NoBillsFound}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="x:Object">
                    <Border Style="{StaticResource Card}" Margin="0,4" Padding="16">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                            <!-- Bill Number + Date -->
                            <Label Grid.Row="0" Grid.Column="0"
                                   FontSize="16" FontAttributes="Bold">
                                <Label.Text>
                                    <MultiBinding StringFormat="Bill #{0} — {1}">
                                        <Binding Path="HeaderId" />
                                        <Binding Path="TransDate" StringFormat="{}{0:D8}" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                            <Label Grid.Row="0" Grid.Column="1"
                                   FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Primary}">
                                <Label.Text>
                                    <Binding Path="NetTotal" StringFormat="{}{0:N2} SAR" />
                                </Label.Text>
                            </Label>

                            <!-- Plate Number + Customer -->
                            <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                   FontSize="13" TextColor="{DynamicResource TextSecondary}">
                                <Label.Text>
                                    <MultiBinding StringFormat="Plate: {0} | Customer: {1}">
                                        <Binding Path="PlateNumber" />
                                        <Binding Path="CustomerName" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>

                            <!-- Paid / Balance -->
                            <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                   FontSize="12" TextColor="{DynamicResource TextSecondary}">
                                <Label.Text>
                                    <MultiBinding StringFormat="Paid: {0:N2} | Balance: {1:N2}">
                                        <Binding Path="Paid" />
                                        <Binding Path="Balance" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>

                            <!-- Action buttons -->
                            <HorizontalStackLayout Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Spacing="6" Margin="0,4,0,0">
                                <Button Text="Preview" FontSize="10" HeightRequest="28" Padding="6,0"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CashierViewModel}}, Path=PreviewBillCommand}"
                                        CommandParameter="{Binding .}"/>
                                <Button Text="Pay" FontSize="10" HeightRequest="28" Padding="6,0"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CashierViewModel}}, Path=PayBillCommand}"
                                        CommandParameter="{Binding .}"/>
                                <Button Text="Print Rec." FontSize="10" HeightRequest="28" Padding="6,0"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CashierViewModel}}, Path=PrintBillCommand}"
                                        CommandParameter="{Binding .}"/>
                                <Button Text="Print A4" FontSize="10" HeightRequest="28" Padding="6,0"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CashierViewModel}}, Path=PrintA4BillCommand}"
                                        CommandParameter="{Binding .}"/>
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Pagination bar at bottom -->
        <Grid Grid.Row="5"
              Padding="20,8,20,16"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="12">
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" WidthRequest="48" HeightRequest="48"
                    IsEnabled="{Binding CanGoToPreviousPage}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding PreviousPageCommand}" />
                </Border.GestureRecognizers>
                <Grid HorizontalOptions="Center" VerticalOptions="Center">
                    <Image WidthRequest="22" HeightRequest="22"
                           helpers:IconHelper.Glyph="&#xebab;"
                           helpers:IconHelper.LightColorResourceKey="IconLight"
                           helpers:IconHelper.DarkColorResourceKey="IconDark" />
                </Grid>
            </Border>
            <Label Grid.Column="1"
                   HorizontalOptions="Center" VerticalOptions="Center"
                   FontSize="14" TextColor="{DynamicResource TextSecondary}">
                <Label.Text>
                    <MultiBinding StringFormat="Page {0} of {1}">
                        <Binding Path="CurrentPage" />
                        <Binding Path="TotalPages" />
                    </MultiBinding>
                </Label.Text>
            </Label>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" WidthRequest="48" HeightRequest="48"
                    IsEnabled="{Binding CanGoToNextPage}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NextPageCommand}" />
                </Border.GestureRecognizers>
                <Grid HorizontalOptions="Center" VerticalOptions="Center">
                    <Image WidthRequest="22" HeightRequest="22"
                           helpers:IconHelper.Glyph="&#xebac;"
                           helpers:IconHelper.LightColorResourceKey="IconLight"
                           helpers:IconHelper.DarkColorResourceKey="IconDark" />
                </Grid>
            </Border>
        </Grid>

        <!-- Loading overlay -->
        <Border Grid.Row="4"
                BackgroundColor="#80FFFFFF"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Fill" VerticalOptions="Fill">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               Color="{StaticResource Primary}" />
        </Border>

    </Grid>
</ContentPage>

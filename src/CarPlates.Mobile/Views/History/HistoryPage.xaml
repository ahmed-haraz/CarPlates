<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CarPlates.Mobile.ViewModels"
             xmlns:converters="clr-namespace:CarPlates.Mobile.Converters"
             xmlns:dtos="clr-namespace:CarPlates.Application.Common.DTOs;assembly=CarPlates.Application"
             xmlns:loc="clr-namespace:CarPlates.Mobile.Localization"
             x:Class="CarPlates.Mobile.Views.History.HistoryPage"
             x:DataType="vm:HistoryViewModel"
             Title="{Binding Title}">

    <ContentPage.Resources>
        <converters:AccessStatusToColorConverter x:Key="AccessStatusToColorConverter" />
        <converters:PlateFormatConverter x:Key="PlateFormatConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
        <!-- Search Bar -->
        <Grid Grid.Row="0"
              Padding="20,18,20,8"
              ColumnDefinitions="*,Auto,Auto">
            <Entry Grid.Column="0"
                   Text="{Binding SearchQuery}"
                   Placeholder="{loc:Translate Key=SearchByPlate}"
                   ReturnCommand="{Binding SearchCommand}" />
            <Button Grid.Column="1"
                    Text="🔍"
                    Style="{StaticResource IconButton}"
                    Command="{Binding SearchCommand}" />
            <Button Grid.Column="2"
                    Text="📅"
                    Style="{StaticResource IconButton}"
                    Command="{Binding ToggleDateFilterCommand}" />
        </Grid>

        <!-- Date Filter Panel -->
        <Grid Grid.Row="1"
              Padding="20,0,20,8"
              ColumnDefinitions="*,*,Auto"
              ColumnSpacing="8"
              IsVisible="{Binding IsDateFilterVisible}">
            <DatePicker Grid.Column="0"
                        Date="{Binding DateFrom}"
                        FontSize="13" />
            <DatePicker Grid.Column="1"
                        Date="{Binding DateTo}"
                        FontSize="13" />
            <HorizontalStackLayout Grid.Column="2" Spacing="4">
                <Button Text="✓" Style="{StaticResource IconButton}"
                        Command="{Binding ApplyDateFilterCommand}" />
                <Button Text="✗" Style="{StaticResource IconButton}"
                        Command="{Binding ClearDateFilterCommand}" />
            </HorizontalStackLayout>
        </Grid>

        <!-- Error Banner -->
        <Border Grid.Row="2"
                BackgroundColor="{StaticResource Error}"
                Padding="14"
                Margin="20,0,20,8"
                IsVisible="{Binding HasError}"
                StrokeShape="RoundRectangle 18">
            <Label Text="{Binding ErrorMessage}"
                   TextColor="White"
                   FontSize="14" />
        </Border>

        <!-- Stats Bar -->
        <Grid Grid.Row="3"
              Padding="20,4"
              ColumnDefinitions="*,Auto">
            <Label Grid.Column="0"
                   Text="{Binding TotalCount, StringFormat='{0} records'}"
                   Style="{StaticResource Caption}" />
            <Button Grid.Column="1"
                    Text="{loc:Translate Key=ExportButton}"
                    Style="{StaticResource IconButton}"
                    Command="{Binding ExportCommand}"
                    FontSize="14" />
        </Grid>

        <!-- Scan List -->
        <RefreshView Grid.Row="4"
                     Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsRefreshing}">
            <CollectionView ItemsSource="{Binding ScanRecords}"
                            EmptyView="{loc:Translate Key=NoScanRecordsFound}">

                <CollectionView.ItemTemplate x:DataType="dtos:ScanRecordListDto">
                    <DataTemplate>
                        <Border Style="{StaticResource Card}"
                                Margin="12,4">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <VerticalStackLayout Grid.Column="0"
                                                     WidthRequest="48">
                                    <Label Text="🚗"
                                           FontSize="24"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1"
                                                     Padding="8,0">
                                    <Label Text="{Binding PlateNumber, Converter={StaticResource PlateFormatConverter}}"
                                           Style="{StaticResource Body}"
                                           FontAttributes="Bold" />
                                    <Label Style="{StaticResource Caption}">
                                        <Label.Text>
                                            <MultiBinding Converter="{StaticResource LanguageAwareConverter}">
                                                <Binding Path="VehicleBrandAr" />
                                                <Binding Path="VehicleBrandEn" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                    <Label Text="{Binding ScanTime, StringFormat='{0:MMM dd, yyyy HH:mm}'}"
                                           Style="{StaticResource Caption}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2"
                                                     HorizontalOptions="End">
                                    <Label Text="{Binding AccessStatus}"
                                           TextColor="{Binding AccessStatus, Converter={StaticResource AccessStatusToColorConverter}}"
                                           FontSize="11"
                                           FontAttributes="Bold" />
                                    <Label Text="{Binding Confidence, StringFormat='{0:P0}'}"
                                           Style="{StaticResource Caption}" />
                                </VerticalStackLayout>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HistoryViewModel}}, Path=ViewDetailsCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </RefreshView>

    </Grid>

</ContentPage>
